{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/t23/v1/(.*)", "dest": "https://dos-biz-stage.vercel.app/t23/v1/$1",
      "transforms": [{ "type": "request.headers", "op": "set", "target": { "key": "x-dos-proxy" }, "args": "$DOS_PROXY_SECRET", "env": ["DOS_PROXY_SECRET"] }] },
    { "src": "/d/([^/]+)", "dest": "https://dos-biz-stage.vercel.app/d/$1",
      "transforms": [{ "type": "request.headers", "op": "set", "target": { "key": "x-dos-proxy" }, "args": "$DOS_PROXY_SECRET", "env": ["DOS_PROXY_SECRET"] }] },
    { "src": "/r/([^/]+)", "dest": "https://dos-biz-stage.vercel.app/r/$1",
      "transforms": [{ "type": "request.headers", "op": "set", "target": { "key": "x-dos-proxy" }, "args": "$DOS_PROXY_SECRET", "env": ["DOS_PROXY_SECRET"] }] },
    { "handle": "filesystem" },
    { "src": "/(?!assets/|_vercel/|js/|d/|r/).*", "dest": "/index.html" }
  ]
}
