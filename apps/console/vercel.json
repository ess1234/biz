{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/t23/v1/:path*", "destination": "https://dos-biz-stage.vercel.app/t23/v1/:path*" },
    { "source": "/d/:key", "destination": "https://dos-biz-stage.vercel.app/d/:key" },
    { "source": "/r/:token", "destination": "https://dos-biz-stage.vercel.app/r/:token" },
    { "source": "/((?!assets/|_vercel/|js/|d/|r/).*)", "destination": "/index.html" }
  ]
}
