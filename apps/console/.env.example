# B2B 콘솔 빌드 변수 (공개 값만). 로컬은 .env.local (git 무시), 배포는 Vercel 환경 변수.
VITE_BRAND=〈서비스〉
VITE_SUPABASE_URL=https://<dossaiBiz ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon>
# 비우면 같은 오리진 /t23/v1 (vercel.json rewrite · vite proxy)
VITE_API_BASE=
# 이미지 영구 주소 호스트 (Cloudflare Worker) — 비우면 API 호스트
VITE_IMAGE_BASE=
