      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./inject": {
      "types": "./src/inject.d.ts",
      "default": "./src/inject.js"
    },
    "./agent": {
      "default": "./src/agent.js"
    }
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "bin": {
    "imagemeta": "bin/imagemeta.js"
  }
